{
  "name": "noms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.5.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --names \"api,web\" -c \"blue,green\" \"npm run dev -w @noms/api\" \"npm run dev -w @noms/web\"",
    "dev:api": "npm run dev -w @noms/api",
    "dev:web": "npm run dev -w @noms/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test -w @noms/api",
    "test:api": "npm run test -w @noms/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.3.3",
    "typescript-eslint": "^8.51.0"
  }
}
