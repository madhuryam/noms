{
  "name": "@noms/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --persist-to .wrangler/state",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply noms-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply noms-db --local",
    "db:list": "wrangler d1 migrations list noms-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed"
  },
  "dependencies": {
    "@jlucaspains/sharp-recipe-parser": "^1.3.6",
    "fflate": "^0.8.2",
    "hono": "^4.6.14",
    "jose": "^6.1.3",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@playwright/test": "^1.57.0",
    "@types/pluralize": "^0.0.33",
    "typescript": "^5.7.2",
    "wrangler": "^4.54.0"
  }
}
